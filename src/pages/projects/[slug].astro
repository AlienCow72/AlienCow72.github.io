---
import Layout from '../../layouts/Layout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/site';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ProjectSection {
  title: string;
  text: string;
  image?: { src: ImageMetadata; alt: string; caption: string };
}

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Layout title={project.name} description={project.description}>
  <article class="wrap article-shell">
    <a class="text-link back-link" href="/projects/">
      <Icon size={16} /> Back to projects
    </a>
    <header class="page-header">
      <p class="eyebrow">
        {project.category} / {project.name}
      </p>
      <h1>{project.title}</h1>
      {[project.intro].flat().map((paragraph) => (
        <p class="project-intro">{paragraph}</p>
      ))}
      <div class="tags">
        {project.tags.map((tag: string) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="project-detail-art">
      <ProjectArt type={project.art} />
    </div>
    <div class="prose">
      {project.sections.map((section: ProjectSection) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
          {section.image && (
            <figure>
              <Image src={section.image.src} alt={section.image.alt} />
              <figcaption>{section.image.caption}</figcaption>
            </figure>
          )}
        </section>
      ))}
      {project.relatedArticle && (
        <p>
          <a href={project.relatedArticle.href}>
            {project.relatedArticle.label}
          </a>
        </p>
      )}
    </div>
  </article>
</Layout>

<style>
  .project-intro + .project-intro {
    margin-top: 16px;
  }
  figure {
    margin: 24px 0 0;
  }
  figcaption {
    margin-top: 8px;
    font-size: 1rem;
    color: var(--muted);
  }
</style>

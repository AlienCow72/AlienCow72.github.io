---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/kyle-anderson.jpg';
import Layout from '../layouts/Layout.astro';
import SignalField from '../components/SignalField.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { site, projects } from '../data/site';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="gold-line" aria-hidden="true"></span>
        <span class="hero-tagline">
          <span>Developer.</span> <span>Consultant.</span>{' '}
          <span>Endlessly curious.</span>
        </span>
      </p>
      <h1>
        A curious mind.
        <br />A <em>builder</em> at heart.
      </h1>
      <p class="hero-description">
        I’m Kyle. I connect systems, turn ideas into software, and find
        inspiration somewhere between code and music.
      </p>
      <div class="hero-actions">
        <a class="button" href="/projects/">
          Explore my work <Icon name="northeast" size={18} />
        </a>
        <a class="text-link" href="/blog/">
          A few things on my mind <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
    <div class="hero-portrait">
      <Image
        src={headshot}
        alt="Kyle Anderson"
        widths={[240, 400, 600, 800]}
        sizes="(max-width: 600px) 112px, (max-width: 900px) 250px, 320px"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-signal">
      <SignalField />
    </div>
  </section>
  <div class="interest-strip">
    <div class="wrap">
      <span>Good things happen at the intersections.</span>
      <div>
        Software <span aria-hidden="true">+</span> Systems{' '}
        <span aria-hidden="true">+</span> Music{' '}
        <span aria-hidden="true">+</span> AI <span aria-hidden="true">+</span>{' '}
        Human curiosity
      </div>
    </div>
  </div>
  <section class="section wrap" id="about">
    <div class="about-layout">
      <div>
        <p class="section-index home-section-index">01 / A LITTLE ABOUT ME</p>
        <h2>
          Practical by nature.
          <br />
          <em>Curious</em> by default.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          I like understanding how things work. Even more, I like making them
          work better together.
        </p>
        <p>
          My work spans software development, integrations, and the messy,
          interesting space between a business problem and a useful solution.
          Away from the technical side, this is also a place to explore music,
          new ideas, and the things worth paying attention to.
        </p>
        <a class="text-link gold" href="/consulting/">
          Meet the consulting side <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
  <section class="section selected-work wrap">
    <div class="section-heading">
      <div>
        <p class="section-index home-section-index">02 / PROJECTS</p>
        <h2>
          Ideas, put to work<span class="gold">.</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        All projects <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="consulting-band wrap">
    <div class="consulting-mark" aria-hidden="true">
      ↗
    </div>
    <div>
      <p class="eyebrow">{site.business}</p>
      <h2>
        A technical partner.
        <br />A human approach.
      </h2>
      <p>Thoughtful software, connected systems, and a clearer path forward.</p>
    </div>
    <a class="button button-outline" href="/consulting/">
      Let’s build something <Icon name="northeast" size={18} />
    </a>
  </section>
  <section class="section wrap writing-section">
    <div class="section-heading">
      <div>
        <p class="section-index home-section-index">
          03 / NOTES &amp; EXPLORATIONS
        </p>
        <h2>
          Ideas worth following<span class="gold">.</span>
        </h2>
      </div>
      <a class="text-link" href="/blog/">
        All writing <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
  <section class="closing wrap">
    <a href={`mailto:${site.email}`}>
      Have something in mind? <em>Let’s talk.</em>
      <Icon name="northeast" size={32} />
    </a>
  </section>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SignalField from '../components/SignalField.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { site, projects } from '../data/site';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="gold-line"></span> DEVELOPER. CONSULTANT. ENDLESSLY
        CURIOUS.
      </p>
      <h1>
        A curious mind.
        <br />A <em>builder</em> at heart.
      </h1>
      <p class="hero-description">
        I’m Kyle. I connect systems, turn ideas into software,
        <br class="desktop-break" /> and find inspiration somewhere between code
        and music.
      </p>
      <div class="hero-actions">
        <a class="button" href="/projects/">
          Explore my work <Icon name="northeast" size={18} />
        </a>
        <a class="text-link" href="/blog/">
          A few things on my mind <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="hero-note">
        <span class="small-plus">+</span> A personal space for building,
        thinking, and everything in between.
      </div>
    </div>
    <SignalField />
  </section>
  <div class="interest-strip">
    <div class="wrap">
      <span>GOOD THINGS HAPPEN AT THE INTERSECTIONS</span>
      <div>
        Software <span>✳</span> Systems <span>✳</span> Music <span>✳</span> AI{' '}
        <span>✳</span> Human curiosity
      </div>
    </div>
  </div>
  <section class="section wrap" id="about">
    <div class="about-layout">
      <div class="section-label">
        <span>01 / A LITTLE ABOUT ME</span>
        <h2>
          Practical by nature.
          <br />
          <em>Curious</em> by default.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          I like understanding how things work. Even more, I like making them
          work better together.
        </p>
        <p>
          My work spans software development, integrations, and the messy,
          interesting space between a business problem and a useful solution.
          Away from the technical side, this is also a place to explore music,
          new ideas, and the things worth paying attention to.
        </p>
        <a class="text-link gold" href="/consulting/">
          Meet the consulting side <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
  <section class="section selected-work wrap">
    <div class="section-heading">
      <div>
        <p class="section-index">02 / SELECTED WORK</p>
        <h2>
          Ideas, put to work<span class="gold">.</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        All projects <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="consulting-band wrap">
    <div class="consulting-mark" aria-hidden="true">
      ↗
    </div>
    <div>
      <p class="eyebrow">{site.business}</p>
      <h2>
        A technical partner.
        <br />A human approach.
      </h2>
      <p>Thoughtful software, connected systems, and a clearer path forward.</p>
    </div>
    <a class="button button-outline" href="/consulting/">
      Let’s build something <Icon name="northeast" size={18} />
    </a>
  </section>
  <section class="section wrap writing-section">
    <div class="section-heading">
      <div>
        <p class="section-index">03 / NOTES & EXPLORATIONS</p>
        <h2>
          A few things on my mind<span class="gold">.</span>
        </h2>
      </div>
      <a class="text-link" href="/blog/">
        All writing <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
  <section class="closing wrap">
    <span class="eyebrow">A GOOD CONVERSATION IS A GOOD START.</span>
    <a href={`mailto:${site.email}`}>
      Have something in mind? <em>Let’s talk.</em>
      <Icon name="northeast" size={32} />
    </a>
  </section>
</Layout>

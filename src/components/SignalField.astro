---
import Icon from './Icon.astro';
---

<div class="signal" role="group" aria-label="Interactive signal field">
  <div class="signal-top">
    <span>
      <span class="status-dot"></span> A little controlled chaos
    </span>
  </div>
  <div class="signal-stage">
    <svg
      class="signal-fallback"
      viewBox="0 0 500 240"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="m190 65-70 55 70 55m120-110 70 55-70 55m-30-135-60 160"
        stroke="currentColor"
        stroke-width="2"
        stroke-dasharray="1 5"
        stroke-linecap="round"
      />
    </svg>
    <canvas
      id="signal-canvas"
      role="img"
      aria-label="A three-dimensional particle sculpture of a code symbol. Use the controls below to change its shape."
    ></canvas>
    <span class="signal-figure">FIG. 001</span>
  </div>
  <div class="signal-bottom">
    <div class="signal-modes" role="group" aria-label="Signal shape">
      <button type="button" data-mode="code" aria-pressed="true">
        <Icon name="code" size={15} /> Code
      </button>
      <button type="button" data-mode="music" aria-pressed="false">
        <Icon name="music" size={15} /> Music
      </button>
      <button type="button" data-mode="ai" aria-pressed="false">
        <Icon name="spark" size={15} /> AI
      </button>
    </div>
    <button
      type="button"
      class="motion-toggle"
      aria-pressed="false"
      aria-label="Pause animation"
    >
      Ⅱ
    </button>
  </div>
  <div class="signal-tilt" hidden>
    <button
      type="button"
      class="tilt-toggle"
      aria-pressed="false"
      aria-describedby="tilt-status"
    >
      Enable tilt
    </button>
    <p id="tilt-status" class="tilt-status" role="status" aria-atomic="true">
      Let your phone's tilt guide the sculpture.
    </p>
  </div>
  <p class="signal-hint">Move your cursor. Follow your curiosity.</p>
</div>
<script>
  import '../scripts/signal';
</script>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(({ target, isIntersecting }) => {
      target.toggleAttribute('data-visible', isIntersecting);
    });
  });
  document.querySelectorAll('.handoff-stage').forEach((stage) => {
    observer.observe(stage);
  });
</script>


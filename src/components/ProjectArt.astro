---
import DstaxMark from './DstaxMark.astro';
import personalMark from '../assets/brand/personal-mark-yellow.svg';

interface Props {
  type: string;
}
const { type } = Astro.props;
const flowMaskId = `integration-flow-${crypto.randomUUID()}`;
const barHeights = [
  76, 24, 91, 43, 18, 65, 34, 84, 52, 12, 71, 39, 96, 28, 58, 21, 81, 47, 68,
  15, 88, 36, 62, 31, 73, 55, 94, 45,
];
---

<div class:list={['project-art', `art-${type}`]} aria-hidden="true">
  {type === 'integration' ? (
    <>
      <span class="diagram-label">CONNECTED BY DESIGN</span>
      <div class="diagram-stage">
        <div class="integration-diagram">
          <svg class="integration-flow" aria-hidden="true">
            <defs>
              <mask id={flowMaskId} maskUnits="userSpaceOnUse">
                <rect class="flow-area" fill="white" />
                <rect class="flow-logo-mask" fill="black" />
              </mask>
            </defs>
            <g mask={`url(#${flowMaskId})`}>
              <circle class="flow-packet" r="3" fill="currentColor">
                <animateMotion
                  dur="2.5s"
                  calcMode="linear"
                  keyPoints="0;1;1"
                  keyTimes="0;0.875;1"
                  repeatCount="indefinite"
                  begin="indefinite"
                />
              </circle>
            </g>
            <rect
              class="flow-completion"
              rx="5"
              fill="none"
              stroke="currentColor"
              opacity="0"
            >
              <animate
                attributeName="opacity"
                values="0;0;1;0"
                keyTimes="0;0.875;0.94;1"
                dur="2.5s"
                repeatCount="indefinite"
                begin="indefinite"
              />
              <animate
                attributeName="stroke-width"
                values="1;1;4;1"
                keyTimes="0;0.875;0.94;1"
                dur="2.5s"
                repeatCount="indefinite"
                begin="indefinite"
              />
            </rect>
          </svg>
          <span class="diagram-node">ERP</span>
          <span class="diagram-line"></span>
          <span class="diagram-core">
            <DstaxMark />
          </span>
          <span class="diagram-line"></span>
          <span class="diagram-node">TAX</span>
        </div>
      </div>
      <span class="diagram-foot">ONE PLATFORM. MORE POSSIBILITIES.</span>
    </>
  ) : type === 'data' ? (
    <>
      <span class="diagram-label">FINDING THE BIGGER PICTURE</span>
      <div class="diagram-stage">
        <div class="data-diagram">
          {barHeights.map((height) => (
            <span data-height={height} style={`--bar: ${height}%;`} />
          ))}
        </div>
      </div>
      <span class="diagram-foot">RECORDS → RELATIONSHIPS → INSIGHT</span>
    </>
  ) : type === 'resume' ? (
    <>
      <span class="diagram-label">ONE RÉSUMÉ. ROOM TO ADAPT.</span>
      <div class="diagram-stage">
        <svg class="resume-diagram" viewBox="0 0 360 250" fill="none">
          <rect x="40" y="16" width="200" height="218" fill="#25282a" />
          <text x="60" y="49" class="resume-caption">
            Master résumé
          </text>
          <text x="60" y="96" class="resume-name">
            Kyle Anderson
          </text>
          <text x="60" y="129" class="resume-copy">
            Experience
          </text>
          <text x="60" y="157" class="resume-copy">
            Projects
          </text>
          <text x="60" y="185" class="resume-copy">
            Skills
          </text>
          <rect x="185" y="147" width="140" height="83" fill="currentColor" />
          <text x="203" y="180" class="resume-export">
            Review. Refine.
          </text>
          <text x="203" y="207" class="resume-export">
            Make it yours.
          </text>
        </svg>
      </div>
      <span class="diagram-foot">EDIT → REFINE → EXPORT</span>
    </>
  ) : (
    <>
      <span class="diagram-label">AN INDEPENDENT LITTLE INTERNET</span>
      <div class="diagram-stage">
        <div class="web-diagram">
          <span class="tiny-nav">
            <img
              class="tiny-brand-mark"
              src={personalMark.src}
              width="22"
              height="22"
              alt=""
            />
            <span>ABOUT &nbsp; WORK &nbsp; WRITING</span>
          </span>
          <span class="tiny-title">
            Stay
            <br />
            <em>curious.</em>
          </span>
          <span class="tiny-orbit"></span>
        </div>
      </div>
      <span class="diagram-foot">BUILT WITH ASTRO. MADE TO EXPLORE.</span>
    </>
  )}
</div>

<script>
  import '../scripts/integration-flow';
  import '../scripts/data-sort';
</script>

<style>
  .integration-diagram {
    position: relative;
  }
  .integration-flow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
  }
  .project-art[data-flow-active] .integration-flow {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .integration-flow {
      display: none;
    }
  }
  /* Reserve independent rows even when the captions wrap at narrow widths. */
  .project-art:has(.diagram-stage) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(40px, auto) minmax(180px, 1fr) minmax(
        40px,
        auto
      );
    justify-items: center;
    gap: 12px;
  }
  .diagram-label,
  .diagram-foot {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    align-self: center;
    margin: 0;
  }
  .diagram-stage {
    container-type: inline-size;
    display: grid;
    place-items: center;
    width: 100%;
    min-width: 0;
    height: 100%;
  }
  .diagram-stage .integration-diagram {
    min-width: 0;
    width: 90%;
    transform: rotate(-8deg);
  }
  .diagram-stage .diagram-core {
    --mark-width: clamp(40px, 25cqi, 75px);
  }
  .diagram-stage .diagram-node {
    padding: 10px 6px;
  }
  .diagram-stage .diagram-line {
    flex: 1;
    min-width: 0;
    max-width: 28px;
  }
  .diagram-stage .data-diagram {
    min-width: 0;
    height: 110px;
    max-width: 360px;
  }
  .diagram-stage .data-diagram span {
    flex: 1;
    min-width: 0;
  }
  .diagram-stage .web-diagram {
    position: relative;
    top: auto;
    width: 90%;
    max-width: 280px;
    height: 150px;
    padding: 12px;
  }
  .diagram-stage .tiny-nav > span {
    font-size: 10px;
    white-space: nowrap;
  }
  .diagram-stage .tiny-title {
    top: 60px;
    font-size: 34px;
  }
  .diagram-stage .tiny-orbit {
    width: 50px;
    height: 50px;
    right: 12px;
    top: 70px;
  }
  .resume-diagram {
    display: block;
    width: 100%;
    height: 180px;
    max-width: 280px;
    min-width: 0;
    min-height: 0;
    margin: auto;
    font-family: var(--sans);
  }
  .resume-caption,
  .resume-copy,
  .resume-name {
    fill: currentColor;
  }
  .resume-caption,
  .resume-copy,
  .resume-export {
    font-size: 16px;
  }
  .resume-name {
    font-family: var(--serif);
    font-size: 25px;
  }
  .resume-export {
    fill: #25282a;
  }
</style>
